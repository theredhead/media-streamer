{
  "name": "media-streamer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "ng serve --host 0.0.0.0",
    "build": "npm run build:server && ng build",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "start": "node dist/server/apps/server/src/main.js",
    "cert:local": "node scripts/create-local-cert.mjs",
    "start:https": "TLS_CERT=.certs/server-cert.pem TLS_KEY=.certs/server-key.pem PORT=3443 npm start",
    "test": "tsx --test apps/server/src/*.test.ts apps/web/src/vr-controls.test.ts"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@theredhead/lucid-foundation": "0.2.0",
    "@theredhead/lucid-kit": "0.2.0",
    "@theredhead/lucid-theme": "0.2.0",
    "express": "^5.1.0",
    "mime-types": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "three": "^0.160.1",
    "zod": "^4.0.0"
  },
  "overrides": {
    "piscina": "^5.3.2"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/express": "^5.0.0",
    "@types/mime-types": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.160.0",
    "@types/webxr": "^0.5.24",
    "concurrently": "^9.0.0",
    "sass": "^1.90.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
