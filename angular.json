{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": { "web": { "projectType": "application", "root": "apps/web", "sourceRoot": "apps/web/src",
    "architect": {
      "build": { "builder": "@angular/build:application", "options": { "outputPath": "dist/web", "index": "apps/web/src/index.html", "browser": "apps/web/src/main.ts", "tsConfig": "apps/web/tsconfig.json", "styles": ["apps/web/src/styles.scss"] } },
      "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "web:build", "proxyConfig": "apps/web/proxy.json" } }
    }
  } }
}
